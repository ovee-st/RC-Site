# Required: Supabase browser and server clients
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required for canonical links and mobile OAuth callbacks
NEXT_PUBLIC_SITE_URL=https://www.mxvlab.com

# Optional: AI features use deterministic fallbacks when this is absent
OPENAI_API_KEY=
OPENAI_RECRUITING_MODEL=
OPENAI_CANDIDATE_MODEL=
OPENAI_INTERVIEW_MODEL=
OPENAI_JOB_IMPORT_MODEL=
OPENAI_SEO_MODEL=
OPENAI_CAREER_COACH_MODEL=

# Optional: Google Analytics client and Measurement Protocol
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# Optional tuning
AI_HUMAN_REVIEW_THRESHOLD=0.65
JOB_IMPORT_DUPLICATE_THRESHOLD=0.82
